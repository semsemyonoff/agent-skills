{
  "adapter": "omp",
  "schema_version": 2,
  "synthetic": true,
  "events": [
    {
      "type": "capabilities",
      "source": "fixture:synthetic-observation",
      "delegation": true,
      "reviewer": true,
      "ask_ui": true,
      "second_opinion": true,
      "second_opinion_route": "second-opinion",
      "native_model": {"task_item": ["string", "ordered"]},
      "native_models": ["fixture-model-standard", "fixture-model-strong"],
      "native_routes": {
        "research": "scout",
        "implementation": ["flow-worker-light", "flow-worker-standard", "flow-worker-strong"],
        "review": "flow-review-standard"
      }
    },
    {
      "type": "phase",
      "source": "fixture:synthetic-observation",
      "name": "recon"
    },
    {
      "type": "dispatch",
      "source": "fixture:synthetic-observation",
      "worker": "research-1",
      "category": "research",
      "params": {
        "context": "Read-only reconnaissance for the checkout rounding plan.",
        "tasks": [
          {
            "agent": "scout",
            "task": "Read checkout behavior",
            "solutionSpace": "Identify current rounding behavior and consumer-visible boundaries; no changes."
          }
        ]
      }
    },
    {
      "type": "phase",
      "source": "fixture:synthetic-observation",
      "name": "plan"
    },
    {
      "type": "plan",
      "source": "fixture:synthetic-observation",
      "id": "P1",
      "scopes": [
        "checkout"
      ],
      "text": "Capability editing; standard complexity: exact decimal/public boundaries require a local choice but API/paths are known. Request flow-worker-standard with its configured medium reasoning and native model role; actual identity is not spawned yet. One separate standard-risk review covers checkout. No publish/configuration writes; model selectors remain native."
    },
    {
      "type": "ask",
      "source": "fixture:synthetic-observation",
      "channel": "ui",
      "supplemental_review": true,
      "opinion_options": ["second-opinion", "decline"],
      "text": "Approve P1 autonomous execution through independent verification and report? Separately, supplemental read-only second-opinion review, or decline?"
    },
    {
      "type": "approval",
      "source": "fixture:synthetic-observation",
      "actor": "user",
      "plan": "P1",
      "phases": [
        "execution",
        "verification",
        "report"
      ],
      "text": "Approve P1. Continue autonomously through verification and report."
    },
    {
      "type": "phase",
      "source": "fixture:synthetic-observation",
      "name": "execution"
    },
    {
      "type": "dispatch",
      "source": "fixture:synthetic-observation",
      "worker": "implementer-1",
      "category": "implementation",
      "scope": "checkout",
      "params": {
        "context": "approved plan P1",
        "tasks": [
          {
            "agent": "flow-worker-standard",
            "task": "Implement only checkout",
            "solutionSpace": "Implement the approved rounding contract only; choose the smallest local correction."
          }
        ]
      }
    },
    {
      "type": "work",
      "source": "fixture:synthetic-observation",
      "actor": "implementer-1",
      "scope": "checkout",
      "kind": "local_write",
      "target": "checkout/rounding.py"
    },
    {
      "type": "phase",
      "source": "fixture:synthetic-observation",
      "name": "verification"
    },
    {
      "type": "dispatch",
      "source": "fixture:synthetic-observation",
      "worker": "reviewer-1",
      "category": "review",
      "params": {
        "context": "review checkout independently",
        "tasks": [
          {
            "agent": "flow-review-standard",
            "task": "Inspect actual checkout changes",
            "solutionSpace": "Implementation is specified; independent acceptance and failure-mode verification remain open."
          }
        ]
      }
    },
    {
      "type": "review",
      "source": "fixture:synthetic-observation",
      "actor": "reviewer-1",
      "scopes": [
        "checkout"
      ],
      "result": "pass",
      "text": "Inspected the changed rounding path and observed exact currency results; no findings."
    },
    {
      "type": "phase",
      "source": "fixture:synthetic-observation",
      "name": "report"
    },
    {
      "type": "report",
      "source": "fixture:synthetic-observation",
      "status": "completed",
      "independent_verified": true,
      "text": "Checkout changed locally on the assessed standard editing profile; one separate standard-risk reviewer covered checkout. Configured/requested selection is distinct from actual identity, which remains unknown if not exposed. No publication or settings writes."
    }
  ]
}
